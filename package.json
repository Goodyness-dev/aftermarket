{
  "name": "aftermarket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node build/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "contract:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/contract.ps1 build",
    "contract:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/contract.ps1 test",
    "testnet:prepare": "node scripts/prepare-testnet.mjs",
    "testnet:verify": "node scripts/verify-testnet.mjs",
    "testnet:loop": "tsx scripts/testnet-loop.ts",
    "release:review": "node scripts/release-review.mjs",
    "release:package": "node scripts/package-source.mjs",
    "format": "prettier --write src tests vite.config.ts"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@babylonjs/loaders": "^8.0.0",
    "@hot-labs/near-connect": "^0.12.0",
    "express": "^5.1.0",
    "near-api-js": "^7.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
