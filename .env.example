# PowerShell: set these environment variables before npm start / npm run dev.
# Node does not automatically read this example file.
PORT=3000
HOST=127.0.0.1
# Enable only for the local custodial demo on this prepared PC:
# NEAR_LIVE_DEMO=1
# DATA_DIR=data/production-demo
# Optional override; the verified deployment is already the default:
# NEAR_CONTRACT_ID=aftermarket-f33ee39d.testnet
# NEAR_RPC_URL=https://test.rpc.fastnear.com
# Never put account private keys in VITE_* variables or client assets.
